{
  "name": "fps-command-center",
  "private": true,
  "version": "1.0.0",
  "description": "FPS Command Center: the dark executive dashboard mounted in the FPS Overview Custom HTML Block (presentation only, read-only data).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build && node scripts/sync-block.mjs",
    "build:bundle": "vite build",
    "sync-block": "node scripts/sync-block.mjs",
    "check:format": "node scripts/format.check.ts",
    "check:fixtures": "node scripts/fixtures.check.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.54.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
